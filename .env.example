# Copiar este archivo a .env y ajustar valores reales antes de desplegar.
# NUNCA subir el archivo .env (con secretos reales) al repositorio.

DB_NAME=recycle_db
DB_USERNAME=admin
DB_PASSWORD=***REMOVED***
DB_URL=jdbc:postgresql://localhost:5432/recycle_db

# Generar una clave nueva y larga para producción, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=***REMOVED***
JWT_EXPIRATION=86400000
